{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidmosiah/delx-wellness/schemas/provider-capabilities.schema.json",
  "title": "Delx Wellness Connector Registry",
  "type": "object",
  "required": [
    "project",
    "description",
    "connectors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "description": "ISO date (YYYY-MM-DD) of the last sync, maintained by scripts/sync-registry.mjs."
    },
    "hosted_hub_boundary": {
      "type": "object",
      "additionalProperties": true
    },
    "agent_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "repository",
          "package",
          "signals",
          "privacy_default"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "planned",
              "paused",
              "deprecated"
            ]
          },
          "repository": {
            "type": "string",
            "format": "uri"
          },
          "package": {
            "type": "string"
          },
          "page": {
            "type": "string",
            "format": "uri"
          },
          "runtime": {
            "type": "string"
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privacy_default": {
            "type": "string"
          },
          "npm_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest npm version, synced by scripts/sync-registry.mjs. Null for unpublished/private packages."
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "signals",
          "privacy_default"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "planned",
              "paused",
              "deprecated"
            ]
          },
          "repository": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "package": {
            "type": [
              "string",
              "null"
            ]
          },
          "agentReadiness": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Public 0-100 agent-readiness score for prioritization and discovery surfaces."
          },
          "transport": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auth_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_storage": {
            "type": [
              "string",
              "null"
            ]
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privacy_default": {
            "type": "string"
          },
          "quality": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string"
              },
              "boundary_contract": {
                "enum": [
                  "remote_api",
                  "multi_provider_api",
                  "local_export",
                  "computational"
                ],
                "description": "Executable boundary family used to select the required request, parser, payload-preservation and failure-observability tests."
              },
              "full_ci": {
                "type": "boolean"
              },
              "security_policy": {
                "type": "boolean"
              },
              "privacy_audit_tool": {
                "type": "boolean"
              },
              "connection_status_tool": {
                "type": "boolean"
              },
              "agent_manifest": {
                "type": "boolean"
              },
              "http_smoke_test": {
                "type": "boolean"
              },
              "registry_backlink": {
                "type": "boolean"
              },
              "context_contract_version": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "entrypoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommended_handoffs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended_handoff": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "mutation_gate": {
            "type": "string",
            "description": "Environment variable or config flag that gates write tools. Empty means read-only by default."
          },
          "mutation_signals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of write/mutation tool surfaces exposed when the mutation_gate is on."
          },
          "npm_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest npm version, synced by scripts/sync-registry.mjs. Null for unpublished/private packages."
          }
        },
        "additionalProperties": false
      }
    },
    "meta_connectors": {
      "type": "array",
      "description": "Meta-MCPs that compose multiple connectors into one surface. Same shape as connectors plus composition metadata.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "signals",
          "privacy_default"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "planned",
              "paused",
              "deprecated"
            ]
          },
          "repository": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "package": {
            "type": [
              "string",
              "null"
            ]
          },
          "transport": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auth_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_storage": {
            "type": [
              "string",
              "null"
            ]
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privacy_default": {
            "type": "string"
          },
          "composes_all_15_connectors": {
            "type": "boolean",
            "description": "True when the meta-connector auto-detects and composes every public Delx Wellness connector."
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tool surfaces the meta-connector exposes."
          },
          "notes": {
            "type": "string"
          },
          "npm_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest npm version, synced by scripts/sync-registry.mjs. Null for unpublished/private packages."
          }
        },
        "additionalProperties": false
      }
    },
    "peers": {
      "type": "array",
      "description": "Independent catalog hops. Not Delx-operated first-party packages. Do not add package or npm_version; this hub does not pin or npm-view peers.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "repository",
          "maintainer",
          "license",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repository": {
            "type": "string",
            "format": "uri"
          },
          "maintainer": {
            "type": "string",
            "description": "GitHub login or public maintainer handle. Not a Delx operator."
          },
          "license": {
            "type": "string",
            "description": "SPDX license id as published by the peer."
          },
          "mcp_registry": {
            "type": "string",
            "description": "Official MCP Registry id if the peer published one. Catalog metadata only — not a Delx pin."
          },
          "listed_version": {
            "type": "string",
            "description": "Version the peer reported on a public registry. Not synced with npm view."
          },
          "shared_contract": {
            "type": "string",
            "description": "Contract the peer reports aligning with, e.g. agent-safe-series/v1. Not an integration promise."
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
